# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite database configuration (much simpler!)
# Local development: sqlite:./data/jobsearch.db
# Docker container: sqlite:/app/data/jobsearch.db
DATABASE_URL=sqlite:/app/data/jobsearch.db

# SQLite data directory (where database file will be stored)
SQLITE_DATA_DIR=/app/data

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================
# Redis connection string for queue management
# Local: redis://localhost:6379
# Docker: redis://redis:6379
# Remote: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# =============================================================================
# GOOGLE API CONFIGURATION (REQUIRED)
# =============================================================================
# Get these from Google Cloud Console
GOOGLE_API_KEY=your_google_custom_search_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment mode
NODE_ENV=production

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Application URL (for webhooks, emails, etc.)
APP_URL=http://localhost:3000

# =============================================================================
# SQLITE BENEFITS
# =============================================================================
# ✅ No separate database container needed
# ✅ Zero configuration required
# ✅ Perfect for single-server deployments
# ✅ Excellent performance for this use case
# ✅ Automatic backups via file system
# ✅ Full ACID compliance and transactions

# =============================================================================
# MONITORING & DEBUGGING (OPTIONAL)
# =============================================================================
# Enable detailed logging
DEBUG=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info
