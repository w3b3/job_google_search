# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string for your AWS EC2 instance
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@your-ec2-instance.amazonaws.com:5432/jobsearch

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================
# Redis connection string for queue management
# Local: redis://localhost:6379
# Docker: redis://redis:6379
# Remote: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# =============================================================================
# GOOGLE API CONFIGURATION (REQUIRED)
# =============================================================================
# Get these from Google Cloud Console
GOOGLE_API_KEY=your_google_custom_search_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment mode
NODE_ENV=production

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Application URL (for webhooks, emails, etc.)
APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL: EXTERNAL DATABASE OVERRIDE
# =============================================================================
# If you want to override the Docker PostgreSQL with your external database
# Uncomment and modify the following:
# DATABASE_URL=postgresql://your_user:your_password@your-aws-ec2-ip:5432/your_database

# =============================================================================
# MONITORING & DEBUGGING (OPTIONAL)
# =============================================================================
# Enable detailed logging
DEBUG=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info
