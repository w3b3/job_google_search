# =============================================================================
# GOOGLE CUSTOM SEARCH API CONFIGURATION
# =============================================================================
# Get your API key from: https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Get your Custom Search Engine ID from: https://cse.google.com/
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# =============================================================================
# JOB SEARCH CONFIGURATION
# =============================================================================

# Primary job search query - use Google search operators for best results
# Examples:
# - '("software engineer" OR "developer") remote'
# - '"product manager" "fintech" -intern'
# - '"data scientist" ("python" OR "machine learning")'
JOB_QUERY=("engineering manager" OR "engineering lead") remote

# Time filter for job postings (in days) - how recent should jobs be?
# Options: 1, 7, 15, 30, 90, 365
TIME_FILTER_DAYS=15

# Maximum results per ATS platform (1-10, Google API limit)
MAX_RESULTS_PER_QUERY=10

# Starting position for search results (usually 1)
SEARCH_START_POSITION=1

# =============================================================================
# KEYWORD MATCHING CONFIGURATION
# =============================================================================

# Keywords to scan for in job descriptions (comma-separated, case-insensitive)
# The tool will only return jobs that contain at least one of these keywords
# Examples:
# - For fintech: stripe,payment,payments,fintech,billing,checkout,banking
# - For AI/ML: tensorflow,pytorch,machine learning,artificial intelligence,nlp
# - For DevOps: kubernetes,docker,aws,terraform,jenkins,ci/cd
KEYWORDS_TO_FIND=stripe,payment,payments,fintech,billing,checkout

# Minimum number of keywords that must match (1 = any keyword, 2+ = multiple required)
MIN_KEYWORD_MATCHES=1

# =============================================================================
# ATS PLATFORM CONFIGURATION
# =============================================================================

# ATS platforms to search (comma-separated)
# Available options:
# - ashby: site:jobs.ashbyhq.com
# - greenhouse: site:boards.greenhouse.io  
# - lever: site:jobs.lever.co
# - workday: site:*.myworkdayjobs.com
# - bamboohr: site:*.bamboohr.com
# - jobvite: site:jobs.jobvite.com
# - smartrecruiters: site:jobs.smartrecruiters.com
# - powered_ashby: intext:"Powered by Ashby" -site:jobs.ashbyhq.com
# - powered_greenhouse: intext:"Powered by Greenhouse" -site:boards.greenhouse.io
# - powered_lever: intext:"Powered by Lever" -site:jobs.lever.co
# - all: enables all platforms
ATS_PLATFORMS=ashby,greenhouse,lever,powered_ashby,powered_greenhouse,powered_lever

# Custom ATS queries (optional) - add your own site-specific searches
# Format: query1|query2|query3 (pipe-separated)
# Example: site:careers.company.com|site:jobs.startup.io
CUSTOM_ATS_QUERIES=

# =============================================================================
# BROWSER & SCRAPING CONFIGURATION
# =============================================================================

# Browser headless mode (true/false) - set to false for debugging
BROWSER_HEADLESS=true

# Page load timeout in milliseconds (default: 20000 = 20 seconds)
PAGE_TIMEOUT=20000

# Delay between requests in milliseconds (be respectful to servers)
REQUEST_DELAY=1000

# User agent string for web scraping (leave empty for default)
USER_AGENT=

# =============================================================================
# OUTPUT & LOGGING CONFIGURATION
# =============================================================================

# Enable verbose logging (true/false)
VERBOSE_LOGGING=false

# Enable debug mode - shows additional information (true/false)
DEBUG_MODE=false

# Output format: console, json, csv (future feature)
OUTPUT_FORMAT=console

# Save results to file (true/false) - future feature
SAVE_RESULTS=false

# Results file path (when SAVE_RESULTS=true)
RESULTS_FILE_PATH=./results.json

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Node.js environment
NODE_ENV=production
